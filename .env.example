# Utiliq v2 — telemetry pipeline
#
# Copy to `.env` to enable. With these unset the app behaves exactly as
# clickdummy-v1: frozen clock, no transport, no telemetry UI.

# Turn the ingest pipeline on. Also unfreezes the clock from DEMO_NOW.
VITE_TELEMETRY=1

# Where the collector's SSE endpoint lives. The browser never speaks MQTT.
VITE_COLLECTOR_URL=http://localhost:4000/stream


# ---------------------------------------------------------------------------
# Collector process (collector/index.mjs) — server-side only, never bundled.
# These are NOT VITE_ prefixed on purpose: broker credentials must not ship to
# the browser.
# ---------------------------------------------------------------------------

# replay | mqtt
SOURCE=replay

# --- replay source ---------------------------------------------------------
# Point this at the capture from 2G:
#   mosquitto_sub -h <host> -t '#' -v -u <user> -P <pass> > 2g_topics.txt
REPLAY_FILE=collector/sample-dump.txt
REPLAY_INTERVAL_MS=1000
REPLAY_LOOP=1

# --- mqtt source (fill in at 2G) -------------------------------------------
# MQTT_URL=mqtt://10.0.0.5:1883
# MQTT_URL=mqtts://broker.2g.local:8883      # TLS
# MQTT_TOPIC=#
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Set to 1 ONLY for a self-signed broker cert on a trusted network.
# MQTT_INSECURE=0

# PORT=4000
# CORS_ORIGIN=*
